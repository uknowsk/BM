ad/s--8q3wnkz7--/yqx1lysvpzrkhszbjogq.jpg\"},{\"Feature\":\"Built-In WIFI, Powered by SmartHQ\u2122 App\",\"Copy\":\"Connect, control and manage your oven from anywhere with your smartphone or tablet (Select features require WIFI connection)\",\"Image\":\"https://images.salsify.com/image/upload/s--YyXQdpM1--/f517f27e5d9ce5ff9b7ebdd75200bc48f099b99b.jpg\"},{\"Feature\":\"Self-Clean Oven with Optional Steam Clean\",\"Copy\":\"Let your oven do the cleaning for you with two ways to eliminate baked-on messes\"},{\"Feature\":\"Soft-Close Door\",\"Copy\":\"Rest assured your oven door will always close softly, thanks to a special hinge that quietly eases it shut\"},{\"Feature\":\"Smart Oven Shortcuts\",\"Copy\":\"Upgrade your cooking with this smart oven shortcut feature, saving your most recently used cooking modes for instant access. Seamlessly blend innovation and efficiency so you can focus on what truly matters \u2014 creating, entertaining, and enjoying\"},{\"Feature\":\"Fit Guarantee\",\"Copy\":\"Ensures your new appliance will fit your existing cutout, or GE Appliances will help cover the modification costs <a href=\\\"https://www.geappliances.com/content/pdfs/GEP_FIT_Guarantee_Rebate_Form.pdf\\\"> <b>See offer criteria and details</b></a>\",\"Image\":\"https://images.salsify.com/image/upload/s--eQDU1Zsr--/xhntee1lzghs4s8ma5yi.jpg\"}], \"variants\":[],\"Value_Prop\":\"\"}", "price": {"without_tax": {"formatted": "$3,299.00", "value": 3299, "currency": "USD"}, "tax_label": "Tax", "rrp_without_tax": {"formatted": "$4,999.00", "value": 4999, "currency": "USD"}, "saved": {"formatted": "$1,700.00", "value": 1700, "currency": "USD"}}, "detail_messages": "", "availability": "", "page_title": "", "default_shipping_expectation_prompt": "We ship available items right away, and backordered items as soon as they're in stock", "height": "57.00", "cart_url": "https://www.geappliances.com/cart.php", "show_backorder_availability_prompt": false, "max_purchase_quantity": 1, "show_qua